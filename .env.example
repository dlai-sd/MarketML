# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production

# API Configuration
API_V1_PREFIX=/v1
API_TITLE=MarketML Persona Builder API
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=sqlite:///./marketml.db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Scraping Configuration
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
SCRAPER_RATE_LIMIT=1.0
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# LinkedIn Credentials (Optional)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_SESSION_COOKIE=

# Google Credentials (Optional)
GOOGLE_EMAIL=
GOOGLE_APP_PASSWORD=

# LLM API (DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Feature Flags
ENABLE_LLM_FALLBACK=true
ENABLE_CACHING=true
ENABLE_MONITORING=true

# Monitoring Ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Azure Configuration (for deployment)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=marketml-rg
AZURE_LOCATION=centralindia
AZURE_CONTAINER_REGISTRY=marketmlacr
